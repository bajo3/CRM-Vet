generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  VETERINARIAN
  RECEPTIONIST
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  ATTENDED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  CRM
  WHATSAPP
  ONLINE
}

enum ConversationStatus {
  AUTOMATED
  REQUIRES_HUMAN
  HUMAN_ACTIVE
  RESOLVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MedicalRecordType {
  CONSULTATION
  VACCINE
  TREATMENT
  CONTROL
  OTHER
}

enum ReminderType {
  CONTROL_DUE
  APPOINTMENT_REMINDER
}

enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
  FAILED
}

enum ClinicStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ScheduledMessageStatus {
  PENDING
  SENT
  CANCELLED
  FAILED
}

model Clinic {
  id                          String                 @id @default(cuid())
  name                        String
  phone                       String?
  timezone                    String                 @default("America/Argentina/Buenos_Aires")
  openingHours                Json
  defaultAppointmentDuration  Int                    @default(30)
  logoUrl                     String?
  /// Texto personalizado del recordatorio de control (`ReminderType.CONTROL_DUE`). `null` = usar el
  /// texto por defecto definido en código (`DEFAULT_CONTROL_REMINDER_TEMPLATE`).
  controlReminderTemplate     String?
  /// Texto personalizado del recordatorio de turno (`ReminderType.APPOINTMENT_REMINDER`). `null` =
  /// usar el texto por defecto definido en código (`DEFAULT_APPOINTMENT_REMINDER_TEMPLATE`).
  appointmentReminderTemplate String?
  /// Profile de Zernio (agrupa la cuenta de WhatsApp de esta clínica). Se crea la primera vez que
  /// alguien inicia la conexión desde Configuración; ver src/lib/whatsapp/zernio-client.ts.
  zernioProfileId             String?                @unique
  /// Cuenta de WhatsApp conectada dentro de ese profile. Null hasta que se completa el Embedded
  /// Signup de Meta y Zernio redirige de vuelta al callback con el accountId.
  zernioAccountId             String?                @unique
  /// Identificador público de la página de reserva online (`/reservar/<slug>`). Null = la clínica
  /// todavía no activó la reserva online.
  bookingSlug                 String?                @unique
  /// Clínica de demostración pública (botón "Probar con la cuenta demo"): cualquiera entra como
  /// dueña, así que se bloquean contraseñas, equipo y conexión de WhatsApp. Ver src/lib/auth/demo.ts.
  isDemo                      Boolean                @default(false)
  /// Clínicas creadas por el seed/scripts entran ya APPROVED; el registro público (`/registro`)
  /// las crea PENDING hasta que un superadmin las apruebe desde `/admin/clinicas`.
  status                      ClinicStatus           @default(PENDING)
  statusReason                String?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  members                     ClinicMember[]
  clients                     Client[]
  pets                        Pet[]
  appointments                Appointment[]
  conversations               WhatsappConversation[]
  messages                    WhatsappMessage[]
  webhookEvents               WebhookEvent[]
  medicalRecords              MedicalRecord[]
  reminders                   Reminder[]
  appointmentActivities       AppointmentActivity[]
  quotes                      Quote[]
  prescriptions               Prescription[]
  reminderRules               ReminderRule[]
  scheduledMessages           ScheduledMessage[]
  products                    Product[]
  sales                       Sale[]
  saleItems                   SaleItem[]
  cashMovements               CashMovement[]
  stockMovements              StockMovement[]
  stockLots                   StockLot[]
  clientPayments              ClientPayment[]
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  passwordHash          String?
  licenseNumber         String?
  /// Cuenta de plataforma (no ligada a ninguna clínica) que puede aprobar/rechazar altas nuevas
  /// desde `/admin/clinicas`. No es un `Role` de `ClinicMember` porque opera por encima de todas
  /// las clínicas, no dentro de una.
  isSuperAdmin          Boolean                @default(false)
  memberships           ClinicMember[]
  appointments          Appointment[]          @relation("VeterinarianAppointments")
  createdAppointments   Appointment[]          @relation("AppointmentCreatedBy")
  assignedConversations WhatsappConversation[]
  medicalRecords        MedicalRecord[]
  appointmentActivities AppointmentActivity[]
  quotes                Quote[]
  prescriptions         Prescription[]
  scheduledMessages     ScheduledMessage[]
  sales                 Sale[]                 @relation("SaleUser")
  voidedSales           Sale[]                 @relation("SaleVoidedBy")
  cashMovements         CashMovement[]
  stockMovements        StockMovement[]
  clientPayments        ClientPayment[]
}

model ClinicMember {
  id       String  @id @default(cuid())
  clinicId String
  userId   String
  role     Role
  active   Boolean @default(true)
  clinic   Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clinicId, userId])
  @@index([clinicId, role, active])
}

model Client {
  id                String                 @id @default(cuid())
  clinicId          String
  name              String
  phone             String
  email             String?
  address           String?
  remindersEnabled  Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  clinic            Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  pets              Pet[]
  conversations     WhatsappConversation[]
  reminders         Reminder[]
  scheduledMessages ScheduledMessage[]
  sales             Sale[]
  payments          ClientPayment[]

  @@unique([clinicId, phone])
  @@index([clinicId, name])
}

model Pet {
  id             String                 @id @default(cuid())
  clinicId       String
  clientId       String
  name           String
  species        String
  breed          String?
  sex            String?
  birthDate      DateTime?
  approximateAge String?
  photoUrl       String?
  weight         Decimal?               @db.Decimal(6, 2)
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  clinic         Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  client         Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  conversations  WhatsappConversation[]
  medicalRecords MedicalRecord[]
  reminders      Reminder[]
  quotes         Quote[]
  prescriptions  Prescription[]
  sales          Sale[]
  stockUsages    StockMovement[]

  @@index([clinicId, name])
}

model Appointment {
  id             String                @id @default(cuid())
  clinicId       String
  petId          String
  veterinarianId String
  createdById    String?
  reason         String
  startAt        DateTime
  endAt          DateTime
  status         AppointmentStatus     @default(PENDING)
  source         AppointmentSource     @default(CRM)
  /// Venta con la que se cobró este turno (null = todavía no se cobró).
  chargedSaleId  String?
  /// Marcado como "no se cobra" desde Pendientes de cobro.
  chargeWaivedAt DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  clinic         Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  pet            Pet                   @relation(fields: [petId], references: [id], onDelete: Restrict)
  veterinarian   User                  @relation("VeterinarianAppointments", fields: [veterinarianId], references: [id], onDelete: Restrict)
  createdBy      User?                 @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  medicalRecords MedicalRecord[]
  reminders      Reminder[]
  activities     AppointmentActivity[]
  chargedSale    Sale?                 @relation(fields: [chargedSaleId], references: [id], onDelete: SetNull)

  @@index([clinicId, veterinarianId, startAt, endAt])
  @@index([clinicId, petId, startAt])
}

model WhatsappConversation {
  id                   String             @id @default(cuid())
  clinicId             String
  clientId             String?
  petId                String?
  assignedUserId       String?
  phone                String
  contactName          String?
  status               ConversationStatus @default(AUTOMATED)
  flowState            Json?
  unreadCount          Int                @default(0)
  lastMessageAt        DateTime           @default(now())
  /// Última vez que el cliente escribió. Con Zernio (Cloud API de Meta) define si la ventana de
  /// 24 h de atención está abierta: fuera de ella solo se puede escribir con mensaje de utilidad.
  lastInboundAt        DateTime?
  /// Conversación equivalente en Zernio, para responder dentro de ella en vez de abrir una nueva.
  zernioConversationId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  clinic               Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  client               Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  pet                  Pet?               @relation(fields: [petId], references: [id], onDelete: SetNull)
  assignedUser         User?              @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages             WhatsappMessage[]

  @@unique([clinicId, phone])
  @@index([clinicId, status, lastMessageAt])
}

model WhatsappMessage {
  id                String               @id @default(cuid())
  clinicId          String
  conversationId    String
  direction         MessageDirection
  content           String
  messageType       String               @default("text")
  externalMessageId String?
  status            String
  attempts          Int                  @default(0)
  createdAt         DateTime             @default(now())
  clinic            Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  conversation      WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([clinicId, externalMessageId])
  @@index([clinicId, conversationId, createdAt])
}

model MedicalRecord {
  id            String            @id @default(cuid())
  clinicId      String
  petId         String
  userId        String
  appointmentId String?
  type          MedicalRecordType
  reason        String
  notes         String?
  weight        Decimal?          @db.Decimal(6, 2)
  treatment     String?
  nextDueDate   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  clinic        Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  pet           Pet               @relation(fields: [petId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  appointment   Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  reminders     Reminder[]
  stockUsages   StockMovement[]

  @@index([clinicId, petId, createdAt])
  @@index([clinicId, nextDueDate])
}

model Quote {
  id        String   @id @default(cuid())
  clinicId  String
  petId     String
  userId    String
  title     String?
  items     Json
  total     Decimal  @db.Decimal(10, 2)
  notes     String?
  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([clinicId, petId, createdAt])
}

model Prescription {
  id        String   @id @default(cuid())
  clinicId  String
  petId     String
  userId    String
  content   String
  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([clinicId, petId, createdAt])
}

/**
 * Regla de recordatorio automático por clínica y tipo de visita (ej: vacuna -> cada 6 meses). Al registrar una visita de ese tipo, se usa como fecha sugerida del próximo control (editable por el profesional).
 */
model ReminderRule {
  id        String            @id @default(cuid())
  clinicId  String
  type      MedicalRecordType
  months    Int
  enabled   Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  clinic    Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, type])
}

model Reminder {
  id                String         @id @default(cuid())
  clinicId          String
  clientId          String
  petId             String
  medicalRecordId   String?
  appointmentId     String?
  type              ReminderType
  scheduledAt       DateTime
  status            ReminderStatus @default(PENDING)
  attempts          Int            @default(0)
  sentAt            DateTime?
  failedAt          DateTime?
  errorMessage      String?
  externalMessageId String?
  deduplicationKey  String         @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  clinic            Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  client            Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pet               Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)
  medicalRecord     MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull)
  appointment       Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([clinicId, petId, type, status])
}

/**
 * Mensaje de WhatsApp de texto libre, escrito a mano por un integrante del equipo desde `/mensajes`
 * y programado para una fecha/hora futura (a diferencia de `Reminder`, que es automático y ligado
 * a reglas por tipo de visita).
 */
model ScheduledMessage {
  id                String                 @id @default(cuid())
  clinicId          String
  clientId          String
  userId            String
  content           String
  scheduledAt       DateTime
  status            ScheduledMessageStatus @default(PENDING)
  attempts          Int                    @default(0)
  sentAt            DateTime?
  errorMessage      String?
  externalMessageId String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  clinic            Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  client            Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user              User                   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status, scheduledAt])
  @@index([clinicId, clientId])
}

model AppointmentActivity {
  id            String      @id @default(cuid())
  clinicId      String
  appointmentId String
  userId        String?
  action        String
  details       Json?
  createdAt     DateTime    @default(now())
  clinic        Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clinicId, appointmentId, createdAt])
}

model WebhookEvent {
  id              String    @id @default(cuid())
  clinicId        String
  externalEventId String
  eventType       String
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  clinic          Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, externalEventId])
}

enum ProductKind {
  PRODUCT
  SERVICE
}

enum PaymentMethod {
  CASH
  DEBIT
  CREDIT
  TRANSFER
  MERCADO_PAGO
  OTHER
  /// Venta a cuenta corriente del cliente: no entra dinero, suma a su saldo deudor.
  ACCOUNT
}

enum StockMovementType {
  PURCHASE
  SALE
  SALE_VOID
  USAGE
  ADJUSTMENT
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum CashMovementType {
  IN
  OUT
}

/// Catálogo de la clínica: productos (alimento, medicamentos, vacunas) y servicios (consulta, baño).
/// Solo los productos con `trackStock` descuentan existencias al venderse.
model Product {
  id         String          @id @default(cuid())
  clinicId   String
  name       String
  kind       ProductKind     @default(PRODUCT)
  price      Decimal         @db.Decimal(12, 2)
  /// Último costo de compra (para margen). Se actualiza al ingresar mercadería.
  cost       Decimal?        @db.Decimal(12, 2)
  trackStock Boolean         @default(false)
  stock      Int             @default(0)
  /// Con `stock <= minStock` el producto se marca como "stock bajo".
  minStock   Int             @default(0)
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  clinic     Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  saleItems  SaleItem[]
  movements  StockMovement[]
  lots       StockLot[]

  @@index([clinicId, active, name])
}

/// Venta cobrada. El total se calcula siempre en el servidor a partir de los ítems. Una venta no se
/// borra: se anula (`VOIDED`), lo que devuelve el stock y la saca de los totales de caja.
model Sale {
  id             String          @id @default(cuid())
  clinicId       String
  clientId       String?
  petId          String?
  userId         String
  paymentMethod  PaymentMethod
  total          Decimal         @db.Decimal(12, 2)
  notes          String?
  status         SaleStatus      @default(COMPLETED)
  voidedAt       DateTime?
  voidedById     String?
  createdAt      DateTime        @default(now())
  clinic         Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  pet            Pet?            @relation(fields: [petId], references: [id], onDelete: SetNull)
  user           User            @relation("SaleUser", fields: [userId], references: [id], onDelete: Restrict)
  voidedBy       User?           @relation("SaleVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  items          SaleItem[]
  stockMovements StockMovement[] @relation("MovementSale")
  chargedUsages  StockMovement[] @relation("UsageChargedSale")
  appointments   Appointment[]

  @@index([clinicId, createdAt])
}

model SaleItem {
  id            String   @id @default(cuid())
  clinicId      String
  saleId        String
  /// Null para un ítem cargado a mano (sin producto del catálogo) o si el producto se eliminó.
  productId     String?
  description   String
  quantity      Int
  unitPrice     Decimal  @db.Decimal(12, 2)
  subtotal      Decimal  @db.Decimal(12, 2)
  /// `false` si el stock ya se había descontado antes (producto usado en una consulta y cobrado
  /// después): al anular la venta no se devuelve, porque el producto igual se aplicó.
  stockDeducted Boolean  @default(true)
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
}

/// Ingreso o egreso manual de efectivo (pago a proveedor, retiro, cambio inicial). Las ventas en
/// efectivo no se registran acá: la caja del día las suma directamente desde `Sale`.
model CashMovement {
  id          String           @id @default(cuid())
  clinicId    String
  userId      String
  type        CashMovementType
  amount      Decimal          @db.Decimal(12, 2)
  description String
  createdAt   DateTime         @default(now())
  clinic      Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([clinicId, createdAt])
}

/// Una sola fila que el cron diario de keepalive actualiza (ver src/app/api/cron/keepalive). Supabase
/// free no cuenta un `SELECT 1` como actividad y pausa el proyecto: una escritura real sí cuenta.
model Heartbeat {
  id     String   @id
  beatAt DateTime
}

/// Lote de un producto con stock controlado. `quantity` es lo que queda de ese lote; las salidas
/// consumen primero el lote que vence antes.
model StockLot {
  id        String          @id @default(cuid())
  clinicId  String
  productId String
  lotNumber String?
  expiresAt DateTime?
  quantity  Int
  createdAt DateTime        @default(now())
  clinic    Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@index([clinicId, productId, expiresAt])
}

/// Historial de stock: cada entrada o salida queda registrada con su motivo. `quantity` es con
/// signo (+ entra, - sale). Una salida que consume varios lotes genera un movimiento por lote.
model StockMovement {
  id              String            @id @default(cuid())
  clinicId        String
  productId       String
  type            StockMovementType
  quantity        Int
  lotId           String?
  unitCost        Decimal?          @db.Decimal(12, 2)
  supplier        String?
  note            String?
  saleId          String?
  medicalRecordId String?
  petId           String?
  userId          String?
  /// Solo para `USAGE`: venta con la que se cobró el producto usado en la consulta.
  chargedSaleId   String?
  /// Solo para `USAGE`: marcado como "no se cobra".
  chargeWaived    Boolean           @default(false)
  createdAt       DateTime          @default(now())
  clinic          Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  lot             StockLot?         @relation(fields: [lotId], references: [id], onDelete: SetNull)
  sale            Sale?             @relation("MovementSale", fields: [saleId], references: [id], onDelete: SetNull)
  chargedSale     Sale?             @relation("UsageChargedSale", fields: [chargedSaleId], references: [id], onDelete: SetNull)
  medicalRecord   MedicalRecord?    @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull)
  pet             Pet?              @relation(fields: [petId], references: [id], onDelete: SetNull)
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clinicId, productId, createdAt])
  @@index([clinicId, type, chargedSaleId])
}

/// Pago de un cliente a su cuenta corriente (cancela deuda de ventas "A cuenta").
model ClientPayment {
  id            String        @id @default(cuid())
  clinicId      String
  clientId      String
  userId        String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  note          String?
  createdAt     DateTime      @default(now())
  clinic        Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([clinicId, clientId, createdAt])
  @@index([clinicId, createdAt])
}
