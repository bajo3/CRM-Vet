DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_vet?schema=public"
APP_URL="http://localhost:3000"
SESSION_SECRET="cambiar-por-un-secreto-largo-generado-con-openssl-rand--base64-32"
INTERNAL_WHATSAPP_TOKEN="cambiar-por-un-secreto-largo"
WHATSAPP_CLINIC_KEY="patitas-demo"
WHATSAPP_AUTH_DIR=".data/baileys/patitas-demo"
WHATSAPP_LOG_LEVEL="info"
WHATSAPP_BRIDGE_URL="http://localhost:3900"
PORT="3900"
# WhatsApp oficial vía Zernio (Meta Cloud API, coexistencia). API key server-side desde el
# dashboard de Zernio (zernio.com/dashboard/api-keys, empieza con sk_). La necesitan la web
# (conexión, estado del número) y el worker de recordatorios (envío de pendientes por Zernio).
ZERNIO_API_KEY=""
# Secreto con el que Zernio firma los webhooks (X-Zernio-Signature). Inventalo largo y aleatorio,
# cargalo en Vercel y registrá el webhook una vez con `npm run zernio:webhook -- <url pública>`.
ZERNIO_WEBHOOK_SECRET=""
# "mock" (default, desarrollo): no envía nada real, solo loguea. "outbox" (producción): encola el
# recordatorio como WhatsappMessage HUMAN_QUEUED para que lo levante el worker de Baileys ya conectado.
REMINDER_PROVIDER="mock"
